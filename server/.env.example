# Eventpatro Server — Environment Variable Template
# Copy this file to .env and fill in real values.
# This file IS safe to commit to git — it contains no real secrets.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/campuspulse
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional SMTP Email Configuration (If unset, OTP codes are logged to the terminal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM_NAME="Eventpatro Sunway"
